<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.app.partmatcher.ui.home.HomeFragment"
        android:label="Home">
        <action
            android:id="@+id/action_homeFragment_to_vinResultFragment"
            app:destination="@id/vinResultFragment" />
        <action
            android:id="@+id/action_homeFragment_to_favoritesFragment"
            app:destination="@id/favoritesFragment" />
        <action
            android:id="@+id/action_homeFragment_to_searchResultsFragment"
            app:destination="@id/searchResultsFragment" />
    </fragment>

    <fragment
        android:id="@+id/searchResultsFragment"
        android:name="com.app.partmatcher.ui.search_results.SearchResultsFragment"
        android:label="Search Results">
        <argument
            android:name="query"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.app.partmatcher.ui.auth.LoginFragment"
        android:label="Login" />

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.app.partmatcher.ui.auth.RegisterFragment"
        android:label="Register" />

    <fragment
        android:id="@+id/vinResultFragment"
        android:name="com.app.partmatcher.ui.vin_result.VinResultFragment"
        android:label="VIN Result">
        <argument
            android:name="vin"
            app:argType="string" />
        <action
            android:id="@+id/action_vinResultFragment_to_partDetailsFragment"
            app:destination="@id/partDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/partDetailsFragment"
        android:name="com.app.partmatcher.ui.part_details.PartDetailsFragment"
        android:label="Part Details">
        <argument
            android:name="partId"
            app:argType="long" />
        <action
            android:id="@+id/action_partDetailsFragment_to_favoritesFragment"
            app:destination="@id/favoritesFragment" />
    </fragment>

    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.app.partmatcher.ui.favorites.FavoritesFragment"
        android:label="Favorites">
        <action
            android:id="@+id/action_favoritesFragment_to_partDetailsFragment"
            app:destination="@id/partDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/analogsFragment"
        android:name="com.app.partmatcher.ui.analogs.AnalogsFragment"
        android:label="Analogs">
        <argument
            android:name="partId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.app.partmatcher.ui.chat.ChatFragment"
        android:label="Support Chat">
        <argument
            android:name="recipientId"
            android:defaultValue="0L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/supportInboxFragment"
        android:name="com.app.partmatcher.ui.chat.SupportInboxFragment"
        android:label="Inbox">
        <action
            android:id="@+id/action_supportInboxFragment_to_chatFragment"
            app:destination="@id/chatFragment" />
    </fragment>

    <fragment
        android:id="@+id/adminStatsFragment"
        android:name="com.app.partmatcher.ui.admin.AdminStatsFragment"
        android:label="Admin Statistics">
        <action
            android:id="@+id/action_adminStatsFragment_to_adminPartListFragment"
            app:destination="@id/adminPartListFragment" />
    </fragment>

    <fragment
        android:id="@+id/adminPartListFragment"
        android:name="com.app.partmatcher.ui.admin.AdminPartListFragment"
        android:label="Admin Part List">
        <action
            android:id="@+id/action_adminPartListFragment_to_partDetailsFragment"
            app:destination="@id/partDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.app.partmatcher.ui.profile.ProfileFragment"
        android:label="Profile" />

</navigation>
